APP_NAME="NPM Gateway"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/npm-gateway/public
APP_TIMEZONE=America/New_York
APP_KEY=
GATEWAY_CREDENTIAL_NOTICE_TO_EMAIL=
GATEWAY_CREDENTIAL_NOTICE_TO_NAME=
GATEWAY_CREDENTIAL_NOTICE_SUBJECT="secure - NPM Gateway User Credentials"
GATEWAY_CREDENTIAL_NOTICE_DRIVER=
GATEWAY_CREDENTIAL_NOTICE_ALLOW_LOCAL_FALLBACK=false
# Optional opt-in PHPUnit database; must be disposable and end in _test.
BOOTSTRAP_INTEGRATION_DB_NAME=

# Local development: plaintext is allowed only with APP_ENV=local/testing
# and DB_HOST set to 127.0.0.1, localhost, or ::1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=npm_gateway
DB_USER=npm_gateway_app
DB_PASSWORD=
DB_SSL_CA=

MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_NAME=npm_gateway
MIGRATION_DB_USER=npm_gateway_migration
MIGRATION_DB_PASSWORD=
MIGRATION_DB_SSL_CA=

# Managed staging/production example (replace values and uncomment):
# APP_ENV=production
# DB_HOST=managed-mysql.example.com
# DB_PORT=16751
# DB_NAME=npm_gateway
# DB_USER=npm_gateway_app
# DB_PASSWORD=
# DB_SSL_CA=C:\path\to\managed-mysql-ca.pem
# MIGRATION_DB_HOST=managed-mysql.example.com
# MIGRATION_DB_PORT=16751
# MIGRATION_DB_NAME=npm_gateway
# MIGRATION_DB_USER=npm_gateway_migration
# MIGRATION_DB_PASSWORD=
# MIGRATION_DB_SSL_CA=C:\path\to\managed-mysql-ca.pem

NATIVE_SESSION_COOKIE_NAME=npm_gateway_ui_state
SESSION_SECURE=false
SESSION_COOKIE_NAME=npm_gateway_session
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=8
SESSION_ROTATION_MINUTES=15
SESSION_ACTIVITY_WRITE_MINUTES=5
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_IP_FAILURE_LIMIT=10
AUTH_IP_FAILURE_WINDOW_MINUTES=10
HR_NEW_EMPLOYEE_NOTIFICATION_RECIPIENTS=noc@npmparks.com
MAIL_FROM_ADDRESS=no-reply@npmpropertiesinc.com
MAIL_FROM_NAME="NPM Gateway"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=tls
