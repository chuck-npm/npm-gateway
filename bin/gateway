<?php

declare(strict_types=1);

use NpmGateway\Console\DatabaseCheckCommand;
use NpmGateway\Console\MigrationCommand;
use NpmGateway\Console\BootstrapAdministratorCommand;
use NpmGateway\Console\StreamConsoleIo;
use NpmGateway\Container\ServiceProvider;
use NpmGateway\Database\DatabaseDiagnostic;
use NpmGateway\Database\DatabaseProfiles;
use NpmGateway\Services\SystemInitializationService;
use NpmGateway\Services\CorporateContextSeeder;

$projectRoot = dirname(__DIR__);

$application = require $projectRoot . DIRECTORY_SEPARATOR . 'bootstrap' . DIRECTORY_SEPARATOR . 'app.php';
$arguments = array_slice($argv, 1);
$command = $arguments[0] ?? '';
$help = implode(PHP_EOL, [
    'NPM Gateway CLI',
    '',
    'Commands:',
    '  database:check <application|migration>',
    '  migrate',
    '  migrate:status',
    '  migrate:rollback',
    '  schema:verify',
    '  bootstrap:administrator',
    '  seed:corporate-context',
]) . PHP_EOL;

if ($command === '' || in_array($command, ['help', '--help', '-h'], true)) {
    fwrite(STDOUT, $help);
    exit(0);
}

if ($command === 'database:check') {
    $profile = $arguments[1] ?? '';
    $config = in_array($profile, DatabaseProfiles::names(), true)
        ? DatabaseProfiles::load($profile, $application['root'])
        : [];
    $result = DatabaseCheckCommand::run(
        $arguments,
        static fn (string $selectedProfile): array => DatabaseDiagnostic::inspect(
            $selectedProfile,
            $config
        ),
        [is_string($config['password'] ?? null) ? $config['password'] : '']
    );
    fwrite(STDOUT, $result['stdout']);
    fwrite(STDERR, $result['stderr']);
    exit($result['exit_code']);
}

if ($command === 'bootstrap:administrator') {
    $container = ServiceProvider::build($application);
    try {
        $bootstrap = new BootstrapAdministratorCommand(
            $container->get(SystemInitializationService::class),
            new StreamConsoleIo()
        );
        exit($bootstrap->run(array_slice($arguments, 1)));
    } finally {
        $connection = $container->get(mysqli::class);
        $connection->close();
    }
}
if($command==='seed:corporate-context'){
    if(count($arguments)!==1){fwrite(STDERR,"This command does not accept arguments.\n");exit(2);}$profile=DatabaseProfiles::load('application',$application['root']);if(!in_array($profile['app_env'],['local','testing'],true)||!in_array($profile['host'],['127.0.0.1','localhost','::1'],true)||($profile['database']!=='npmgateway'&&!str_ends_with($profile['database'],'_test'))){fwrite(STDERR,"Corporate context seeding is restricted to approved local databases.\n");exit(2);}$container=ServiceProvider::build($application);try{$result=$container->get(CorporateContextSeeder::class)->seed();fwrite(STDOUT,$result->created?"Corporate operational context created.\n":"Corporate operational context already exists; no changes made.\n");exit(0);}catch(Throwable $e){fwrite(STDERR,str_replace(["\r","\n"],' ',$e->getMessage())."\n");exit(1);}finally{$container->get(mysqli::class)->close();}
}

if (!in_array($command, ['migrate', 'migrate:status', 'migrate:rollback', 'schema:verify'], true)) {
    fwrite(STDERR, "Unknown command: {$command}\n\n{$help}");
    exit(2);
}
if (count($arguments) !== 1) {
    fwrite(STDERR, "This command does not accept arguments.\n");
    exit(2);
}

$config = DatabaseProfiles::load('migration', $application['root']);
try {
    $lines = MigrationCommand::execute(
        $command,
        $config,
        $application['root'] . DIRECTORY_SEPARATOR . 'database' . DIRECTORY_SEPARATOR . 'migrations'
    );
    fwrite(STDOUT, implode(PHP_EOL, $lines) . PHP_EOL);
    exit(0);
} catch (Throwable $exception) {
    $message = str_replace(["\r", "\n"], ' ', $exception->getMessage());
    foreach (['password', 'host', 'ssl_ca'] as $key) {
        $secret = is_string($config[$key] ?? null) ? $config[$key] : '';
        if ($secret !== '') {
            $message = str_replace($secret, '[redacted]', $message);
        }
    }
    fwrite(STDERR, "Command failed: {$message}\n");
    exit(1);
}
